generator client {
  provider = "prisma-client"
  output   = "../../src/generated/auth"
}

datasource db {
  provider = "postgresql"
  url      = env("AUTH_DATABASE_URL")
}

enum AuthStatus {
  active
  revoked
}

model AuthSession {
  id         String     @id @default(uuid())
  platform   String
  account    String
  host       String
  userAgent  String
  headers    Json
  cookieJar  Json
  status     AuthStatus @default(active)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  expiresAt  DateTime

  @@index([platform, account, host])
  @@index([platform, account, host, status])
  @@index([expiresAt])
  @@index([account])
}
