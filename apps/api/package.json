{
  "name": "@omni/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "build": "bun build ./src/index.ts --outdir=dist",
    "start": "node ./dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:migrate": "prisma migrate dev",
    "db:generate": "prisma generate",
    "db:generate:all": "bun run db:generate && bun run db:auth:generate",
    "db:studio": "prisma studio",
    "db:push": "bun db:generate && bun db:migrate",
    "db:auth:migrate": "prisma migrate dev --schema prisma/auth/schema.prisma",
    "db:auth:generate": "prisma generate --schema prisma/auth/schema.prisma",
    "db:auth:studio": "prisma studio --schema prisma/auth/schema.prisma",
    "queue:worker": "bun --watch src/worker.ts"
  },
  "dependencies": {
    "@bull-board/api": "^6.12.7",
    "@bull-board/express": "^6.12.7",
    "@prisma/client": "^6.15.0",
    "bullmq": "^5.58.4",
    "dotenv": "^17.2.1",
    "express": "^5.1.0",
    "ioredis": "^5.7.0",
    "openai": "^5.16.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "prisma": "^6.15.0",
    "@types/express": "^5.0.3",
    "@types/node": "^24.3.0",
    "@types/bun": "^1.2.21",
    "typescript": "^5.9.2",
    "eslint": "^9.34.0",
    "@typescript-eslint/parser": "^8.41.0",
    "@typescript-eslint/eslint-plugin": "^8.41.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.6.2"
  }
}
