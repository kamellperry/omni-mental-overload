DATABASE_URL=postgresql://postgres:postgres@localhost:5432/omni
REDIS_URL=redis://redis:6379
PORT=3000

- SCHED_ENABLE_QUALIFY=true
- SCHED_ENABLE_DISPATCH=true
- SCHED_ENABLE_FEEDBACK=true
- SCHED_ENABLE_CRAWL_REFRESH=false
- SCHED_QUALIFY_CRON=15 0 * * *
- SCHED_DISPATCH_CRON=5 * * * *
- SCHED_FEEDBACK_CRON=*/15 * * * *
- SCHED_CRAWL_REFRESH_EVERY_MS=1800000
- SCHED_CRAWL_SEEDS_READY=false