# Postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=omni
POSTGRES_PORT=5432
POSTGRES_HOST=postgres

# Prisma
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/omni
# Separate auth DB (for AuthAccount/AuthSession)
AUTH_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/omni_auth

# Redis
REDIS_URL=redis://redis:6379

# LLM
OLLAMA_BASE_URL=http://ollama:11434

# API
PORT=3000
NODE_ENV=development

# PyDoll (Account Manager provider)
# Where our API calls to get/create sessions. For Docker, use http://pydoll:8080 if you add a pydoll service.
PYDOLL_BASE_URL=http://localhost:8080
# Bearer token our API uses when talking to PyDoll (set the same secret in PyDoll)
PYDOLL_AUTH_TOKEN=change-me-dev-pydoll-token

# Crawler
CRAWLER_BASE_URL=http://localhost:8000

# Worker (bundle selection)
# Internal ID of the AuthAccount returned by onboarding
AUTH_ACCOUNT_ID=
# Host to request bundles for: www.instagram.com or i.instagram.com
AUTH_HOST=www.instagram.com